{
  "name": "obsidian-lan-sync",
  "version": "0.0.1",
  "description": "Obsidian LAN sync between desktop and mobile over the same Wi-Fi, without any cloud service.",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "test:server": "pnpm build:server && node tests/server.test.cjs",
    "serve": "pnpm build:server && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
