{
  "name": "obsidian-lan-sync",
  "version": "0.7.9",
  "description": "Obsidian LAN sync between desktop and mobile over the same Wi-Fi, without any cloud service.",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "build:core": "esbuild src/core/index.ts --bundle --platform=node --format=cjs --outfile=dist/core.cjs",
    "build:webdav": "esbuild src/net/webdav-protocol.ts --bundle --platform=node --format=cjs --outfile=dist/webdav.cjs",
    "test:core": "pnpm build:core && node tests/core.test.cjs",
    "test:webdav": "pnpm build:webdav && node tests/webdav.test.cjs",
    "test:server": "pnpm build:server && node tests/server.test.cjs",
    "test:e2e": "pnpm build:server && pnpm build:core && node tests/e2e.test.cjs",
    "test": "pnpm test:core && pnpm test:webdav && pnpm test:server && pnpm test:e2e",
    "serve": "pnpm build:server && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9"
}
